# Copy to .env and fill in. .env is git-ignored.
# See README.md for how to discover each of these.

# The box to deploy to -- any Ubuntu 24.04 host reachable by SSH.
SERVER_HOST="ubuntu@xxx.xxx.xxx.xxx"
SSH_PRIVATE_KEY_FILE="$HOME/.ssh/terraria-server.key"

# Sibling of this repo, deliberately not committed -- see README.
TMOD_STAGING_DIR="../tmod-staging"

# Set your target tModLoader version, then get the exact zip URL from its
# release page -- don't trust a guessed tag name.
TMODLOADER_VERSION="2026.06.3.6"
TMODLOADER_ZIP_URL="https://github.com/tModLoader/tModLoader/releases/download/vXXXX/tModLoader.zip"

# World name and server password -- deploy.sh templates these into
# serverconfig.txt (see server/serverconfig.txt.example).
WORLD_NAME="YourWorld"
SERVER_PASSWORD="CHANGE_ME"

# World size (1=small 2=medium 3=large), difficulty (0=normal 1=expert
# 2=master 3=journey), and player cap -- also templated into
# serverconfig.txt. Only take effect the first time the world is generated;
# changing them later requires deleting the .wld/.twld files on the server
# and re-running deploy.sh to regenerate (see README).
WORLD_SIZE="2"
WORLD_DIFFICULTY="0"
MAX_PLAYERS="8"

# Space-separated internal mod names (not Workshop display names -- check
# the actual .tmod filename). deploy.sh generates enabled.json from this.
ENABLED_MODS="ExampleMod AnotherExampleMod"

# Space-separated .tmod filenames of client-side/NoSync mods (health bar
# overlays, minimap tweaks, etc) that must never reach the server --
# deploy.sh refuses to run if one turns up in TMOD_STAGING_DIR. Leave empty
# if you have none.
CLIENT_ONLY_MODS="ExampleClientOnlyMod.tmod"
